// docs/specs/pack-__PACK_KEBAB__.md AC-1..AC-7 against Postgres (TEST_DATABASE_URL_OWNER / TEST_DATABASE_URL): the pack
// registers its partner ext, entity, action and menu; apply seeds once and is idempotent; force and sample; permissions;
// company and application boundaries; ext validation, filter and search; /meta. Generated by scripts/pack-new.mjs:
// keep these checks and add the pack's own business rules next to them.
import {
  appMeta,
  applyPack,
  auditTrail,
  newId,
  PACKS_APPLIED_KEY,
  readAppliedPacks,
  registerCrudActions,
  registerPackActions,
  registry,
  repo,
  runAction,
  ValidationError,
  type Context,
} from '@daifuku/kernel';
import { freshDb, type TestDb } from '@daifuku/kernel/testing';
import { Partner } from '@daifuku/mod-partner';
import { afterAll, beforeAll, describe, expect, it } from 'vitest';
import { __PACK_PASCAL__Pack, __PACK_PASCAL__Tag, SAMPLE_NOTE, SAMPLE_PARTNER_CODES, SEED_TAGS } from '../src/index.ts';

const PACK = '__PACK_SNAKE__';
const TAG = '__PACK_SNAKE___tag';
const COUNT = '__PACK_SNAKE__.count_tags';
const EXT = '__PACK_CAMEL__Note';
const T1 = new Date('2026-01-05T01:00:00.000Z');
const T2 = new Date('2026-01-06T01:00:00.000Z');

let db: TestDb;
let companyB: string;
let companyC: string;
const at = (d: Date) => ({ now: () => d });
const asUser = (roles: string[], extra: Record<string, unknown> = {}) => ({
  roles,
  actor: { type: 'user' as const, id: newId() },
  ...extra,
});
const tagsOf = (ctx: Context) => repo(ctx, __PACK_PASCAL__Tag).list({ orderBy: [{ field: 'code', dir: 'asc' }] });
const seedCodes = SEED_TAGS.map((t) => t.code).sort();

async function companySettings(companyId: string): Promise<Record<string, unknown>> {
  const rows = await db.owner.sql`select settings from companies where id = ${companyId}`;
  return (rows[0]?.settings ?? {}) as Record<string, unknown>;
}

beforeAll(async () => {
  registerCrudActions();
  registerPackActions();
  db = await freshDb();
  companyB = newId();
  await db.owner
    .sql`insert into companies (id, tenant_id, code, name) values (${companyB}, ${db.tenantId}, 'T2', 'Company B')`;
  companyC = newId();
  await db.owner
    .sql`insert into companies (id, tenant_id, code, name) values (${companyC}, ${db.tenantId}, 'T3', 'Company C')`;
});
afterAll(async () => {
  await db.close();
});

describe('pack __PACK_SNAKE__: definition', () => {
  it('AC-1 importing the package registers the pack, its partner ext, the entity with CRUD actions, the action and the menu', () => {
    expect(registry.packs().map((p) => p.name)).toContain(PACK);
    expect(__PACK_PASCAL__Pack).toMatchObject({ name: PACK, version: '0.1.0', depends: ['partner'] });
    expect(
      registry
        .extFields('partner')
        .filter((d) => d.source === `pack:${PACK}`)
        .map((d) => d.key),
    ).toEqual([EXT]);
    expect(__PACK_PASCAL__Tag.module).toBe(PACK);
    expect(registry.action(COUNT)).toMatchObject({
      module: PACK,
      mutates: false,
      tx: 'none',
      permission: { entity: TAG, op: 'read' },
    });
    expect(registry.hasAction(`${TAG}.create`)).toBe(true);
    expect(registry.hasAction(`${TAG}.list`)).toBe(true);
    expect(__PACK_PASCAL__Pack.menus).toEqual([{ label: __PACK_PASCAL__Tag.config.label, entity: TAG, order: 90 }]);
  });
});

describe('pack __PACK_SNAKE__: apply', () => {
  it('AC-2 the first apply seeds the three tags and records packs.applied; the sample does not run without the flag', async () => {
    const res = await db.run(at(T1), (ctx) => applyPack(ctx, PACK));
    expect(res).toMatchObject({
      name: PACK,
      version: '0.1.0',
      alreadyApplied: false,
      seeded: true,
      sampled: false,
      settings: { written: [], kept: [] },
    });
    expect((await db.run({}, tagsOf)).items.map((t) => t.code)).toEqual(seedCodes);
    expect((await companySettings(db.companyId))[PACKS_APPLIED_KEY]).toEqual({
      [PACK]: { at: T1.toISOString(), version: '0.1.0' },
    });
    expect(await db.run({}, (ctx) => repo(ctx, Partner).count({ code: { $in: [...SAMPLE_PARTNER_CODES] } }))).toBe(0);
  });

  it('AC-2 a second apply writes nothing: tag versions, company settings and audit rows are unchanged', async () => {
    const before = await db.run({}, tagsOf);
    const settingsBefore = await companySettings(db.companyId);
    const auditBefore = await db.run({}, (ctx) => auditTrail(ctx, 'company_settings', db.companyId));
    const res = await db.run(at(T2), (ctx) => applyPack(ctx, PACK));
    expect(res).toMatchObject({ alreadyApplied: true, seeded: false, sampled: false, record: { at: T1.toISOString() } });
    const after = await db.run({}, tagsOf);
    expect(after.items.map((t) => [t.code, t.version])).toEqual(before.items.map((t) => [t.code, t.version]));
    expect(await companySettings(db.companyId)).toEqual(settingsBefore);
    expect(await db.run({}, (ctx) => auditTrail(ctx, 'company_settings', db.companyId))).toHaveLength(
      auditBefore.length,
    );
  });

  it('AC-3 force re-runs the seed without duplicating tags; sample creates its partner once and not again', async () => {
    const forced = await db.run(at(T2), (ctx) => applyPack(ctx, PACK, { force: true }));
    expect(forced).toMatchObject({ alreadyApplied: true, seeded: true, record: { at: T2.toISOString() } });
    expect((await db.run({}, tagsOf)).items.map((t) => t.code)).toEqual(seedCodes);

    const sampled = await db.run(at(T2), (ctx) => applyPack(ctx, PACK, { sample: true }));
    expect(sampled).toMatchObject({ sampled: true, record: { sampledAt: T2.toISOString() } });
    const partners = await db.run({}, (ctx) =>
      repo(ctx, Partner).list({ where: { code: { $in: [...SAMPLE_PARTNER_CODES] } } }),
    );
    expect(partners.items.map((p) => [p.code, p.ext])).toEqual([[SAMPLE_PARTNER_CODES[0], { [EXT]: SAMPLE_NOTE }]]);
    const again = await db.run(at(T2), (ctx) => applyPack(ctx, PACK, { sample: true }));
    expect(again.sampled).toBe(false);
    expect(await db.run({}, (ctx) => repo(ctx, Partner).count({ code: { $in: [...SAMPLE_PARTNER_CODES] } }))).toBe(1);
  });
});

describe('pack __PACK_SNAKE__: permissions', () => {
  it('AC-4 pack.apply is admin-only: admin runs the action (already applied, nothing written), sales is denied', async () => {
    expect(await db.run({}, (ctx) => runAction(ctx, 'pack.apply', { name: PACK }))).toMatchObject({
      name: PACK,
      alreadyApplied: true,
      seeded: false,
    });
    await expect(db.run(asUser(['sales']), (ctx) => runAction(ctx, 'pack.apply', { name: PACK }))).rejects.toMatchObject(
      { code: 'PERMISSION_DENIED' },
    );
  });

  it('AC-4 viewer reads tags and runs count_tags but cannot create; a role without a grant and store- or site-scoped contexts are denied', async () => {
    const viewer = asUser(['viewer']);
    expect((await db.run(viewer, tagsOf)).items.map((t) => t.code)).toEqual(seedCodes);
    expect(await db.run(viewer, (ctx) => runAction(ctx, COUNT, {}))).toEqual({ count: SEED_TAGS.length });
    await expect(
      db.run(viewer, (ctx) => repo(ctx, __PACK_PASCAL__Tag).create({ code: 'viewer-made', name: 'x' })),
    ).rejects.toMatchObject({ code: 'PERMISSION_DENIED' });

    const accounting = asUser(['accounting']);
    await expect(db.run(accounting, tagsOf)).rejects.toMatchObject({ code: 'PERMISSION_DENIED' });
    await expect(db.run(accounting, (ctx) => runAction(ctx, COUNT, {}))).rejects.toMatchObject({
      code: 'PERMISSION_DENIED',
    });

    // The master declares no storeAccess/siteAccess: a scoped context is denied on count_tags, on the generic CRUD
    // action and on the repository, for admin too. Keep these when adding a store or site policy to the master.
    for (const scope of [
      { accessScope: 'stores' as const, storeIds: [newId()] },
      { accessScope: 'sites' as const, siteIds: [newId()] },
    ]) {
      const denied = { code: 'PERMISSION_DENIED' };
      const scopedViewer = asUser(['viewer'], scope);
      await expect(db.run(scopedViewer, (ctx) => runAction(ctx, COUNT, {})), scope.accessScope).rejects.toMatchObject(
        denied,
      );
      await expect(db.run(scopedViewer, (ctx) => runAction(ctx, `${TAG}.list`, {})), scope.accessScope).rejects.toMatchObject(
        denied,
      );
      await expect(
        db.run(asUser(['admin'], scope), (ctx) => repo(ctx, __PACK_PASCAL__Tag).create({ code: 'scoped-made', name: 'x' })),
        scope.accessScope,
      ).rejects.toMatchObject(denied);
    }
  });
});

describe('pack __PACK_SNAKE__: company and application boundaries', () => {
  it('AC-5 with the pack applied to companies A and B, a tag created in A is not listed, counted or returned by count_tags in B', async () => {
    await db.run({ companyId: companyB, ...at(T1) }, (ctx) => applyPack(ctx, PACK));
    await db.run({}, (ctx) => repo(ctx, __PACK_PASCAL__Tag).create({ code: 'only-a', name: 'A only' }));
    const inB = { companyId: companyB };
    expect((await db.run(inB, tagsOf)).items.map((t) => t.code)).toEqual(seedCodes);
    expect(await db.run(inB, (ctx) => repo(ctx, __PACK_PASCAL__Tag).count())).toBe(SEED_TAGS.length);
    expect(await db.run(inB, (ctx) => runAction(ctx, COUNT, {}))).toEqual({ count: SEED_TAGS.length });
    expect(await db.run({}, (ctx) => runAction(ctx, COUNT, {}))).toEqual({ count: SEED_TAGS.length + 1 });
  });

  it('AC-5 in a company without the pack even an admin cannot list or create tags or run count_tags', async () => {
    const inC = { companyId: companyC };
    await expect(db.run(inC, tagsOf)).rejects.toMatchObject({ code: 'PERMISSION_DENIED' });
    await expect(
      db.run(inC, (ctx) => repo(ctx, __PACK_PASCAL__Tag).create({ code: 'c-made', name: 'x' })),
    ).rejects.toMatchObject({ code: 'PERMISSION_DENIED' });
    await expect(db.run(inC, (ctx) => runAction(ctx, COUNT, {}))).rejects.toMatchObject({ code: 'PERMISSION_DENIED' });
  });
});

describe('pack __PACK_SNAKE__: partner ext', () => {
  it('AC-6 a partner whose ext note exceeds 200 characters is rejected on the ext path and nothing is written', async () => {
    const before = await db.run({}, (ctx) => repo(ctx, Partner).count());
    const err = await db
      .run({}, (ctx) => repo(ctx, Partner).create({ name: 'Too long', ext: { [EXT]: 'x'.repeat(201) } }))
      .catch((e: unknown) => e);
    expect(err).toBeInstanceOf(ValidationError);
    expect(err).toMatchObject({ details: { issues: [{ path: `ext.${EXT}` }] } });
    expect(await db.run({}, (ctx) => repo(ctx, Partner).count())).toBe(before);
  });

  it('AC-6 the sample partner is found by a where condition on the ext field and by search', async () => {
    const byExt = await db.run({}, (ctx) => repo(ctx, Partner).list({ where: { [`ext.${EXT}`]: SAMPLE_NOTE } }));
    expect(byExt.items.map((p) => p.code)).toEqual([SAMPLE_PARTNER_CODES[0]]);
    const found = await db.run({}, (ctx) => repo(ctx, Partner).list({ search: SAMPLE_NOTE }));
    expect(found.items.map((p) => p.code)).toEqual([SAMPLE_PARTNER_CODES[0]]);
  });
});

describe('pack __PACK_SNAKE__: /meta', () => {
  it('AC-7 appMeta shows the ext field, the applied pack, its menu and entity; an unapplied company sees none of them', async () => {
    const meta = await db.run({}, async (ctx) =>
      appMeta(ctx, { appliedPacks: Object.keys(await readAppliedPacks(ctx)) }),
    );
    const partner = meta.entities.find((e) => e.name === 'partner');
    expect(partner?.extFields.map((x) => ({ name: x.name, source: x.source, searchable: x.searchable }))).toEqual([
      { name: `ext.${EXT}`, source: `pack:${PACK}`, searchable: true },
    ]);
    expect(meta.packs).toEqual([{ name: PACK, label: __PACK_PASCAL__Pack.label, applied: true }]);
    expect(meta.modules.find((m) => m.name === PACK)?.menus).toEqual([
      { label: __PACK_PASCAL__Tag.config.label, entity: TAG, order: 90 },
    ]);
    expect(meta.entities.find((e) => e.name === TAG)?.module).toBe(PACK);

    const unapplied = await db.run({ companyId: companyC, ...asUser(['viewer']) }, async (ctx) => appMeta(ctx));
    expect(unapplied.packs).toEqual([{ name: PACK, label: __PACK_PASCAL__Pack.label, applied: false }]);
    expect(unapplied.modules.some((m) => m.name === PACK)).toBe(false);
    expect(unapplied.entities.some((e) => e.name === TAG)).toBe(false);
    expect(unapplied.entities.find((e) => e.name === 'partner')?.extFields).toEqual([]);
  });
});
