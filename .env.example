# Local development and disposable CI only. For installation use docs/operations/setup.md.
# Owner role: migrations, seeds, system context
DATABASE_URL_OWNER=postgres://daifuku_owner:owner@localhost:5432/daifuku_dev
# App role: request handling (RLS enforced)
DATABASE_URL=postgres://daifuku_app:app@localhost:5432/daifuku_dev
# Test DB (owner + app)
TEST_DATABASE_URL_OWNER=postgres://daifuku_owner:owner@localhost:5432/daifuku_test
TEST_DATABASE_URL=postgres://daifuku_app:app@localhost:5432/daifuku_test
JWT_SECRET=dev-secret-change-me
HOST=127.0.0.1
PORT=3000
# Production or non-loopback binding rejects weak JWT secrets.
# Optional exact origins; production defaults to no cross-origin access.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Evidence file storage (kernel storage port)
DAIFUKU_STORAGE_DIR=.data/storage

# Packs to load (comma-separated: example,retail,real_estate; `all` = every available pack; `none`). Applying a pack to a
# company is separate: `pnpm pack:apply <name>`.
DAIFUKU_PACKS=all

# Optional identity setup (all values remain commented until configured).
# See docs/operations/enterprise-identity.md. Generate and protect a random 32-byte Base64 key.
# IDENTITY_ENCRYPTION_KEY=<generated-secret>
# PUBLIC_WEB_URL=https://erp.example.com
# OIDC_PROVIDERS_JSON=[]
# Each OIDC item: id,label,tenantId,issuer,clientId,clientSecret,authorizationEndpoint,tokenEndpoint,jwksUri.
# Register the exact callback https://erp.example.com/auth/oidc/callback at the IdP.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=<mail-service-user>
# SMTP_PASSWORD=<mail-service-secret>
# SMTP_FROM=erp@example.com
# SMTP_SECURE=false
# TLS is mandatory: false means STARTTLS, true means implicit TLS (normally port 465).
# Run delivery explicitly: pnpm --filter @daifuku/api mail:deliver
# MFA-enabled MCP startup also needs one current DAIFUKU_MFA_CODE (TOTP or unused recovery code).
# Preferred for MCP: an API key issued on /admin/tokens with purpose MCP (needs IDENTITY_ENCRYPTION_KEY on the API to
# issue). Do not set DAIFUKU_EMAIL / DAIFUKU_PASSWORD / DAIFUKU_MFA_CODE / DAIFUKU_TENANT_ID together with it.
# DAIFUKU_API_KEY=<dfk_ key shown once at issue>

# Business event delivery worker (docs/specs/event-delivery.md). Off by default: starting the API sends nothing.
# EVENT_WORKER_ENABLED=false
# EVENT_WORKER_INTERVAL_MS=10000
# EVENT_INBOX_CHECK_MINUTES=15
# Webhooks need IDENTITY_ENCRYPTION_KEY (signing secrets are encrypted with it); inbox mail also needs SMTP_* and PUBLIC_WEB_URL.
# Development/test only: let http://127.0.0.1 / localhost endpoints connect to loopback (refused unless NODE_ENV is development or test).
# EVENT_WEBHOOK_ALLOW_LOOPBACK=false
# Or run one tick from a scheduler instead: pnpm --filter @daifuku/api events:deliver

# Optional Square webhook connections; [] means no configured connection, never connected success.
# SQUARE_POS_CONNECTIONS_JSON=[]
# Each item: key,tenantId,userId,companyId,locationId,merchantId,externalLocationId,notificationUrl,signatureKey.
# locationId is Daifuku's POS location UUID; externalLocationId is Square's location identifier.
# notificationUrl must exactly match the registered HTTPS /webhooks/square/<key> URL.
# Keep signatureKey/clientSecret/passwords outside Git. No real provider credentials are bundled.
