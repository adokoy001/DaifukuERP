{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "kernel/src",
    "modules/*/src",
    "l10n/*/src",
    "packs/*/src",
    "apps/*/src",
    "apps/edge/setup",
    "scripts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist"
  ]
}
