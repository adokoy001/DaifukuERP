{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Isolated Daifuku ERP single-host trial. No references to existing game compute, database, network or IAM.",
  "Parameters": {
    "ImageId": {
      "Type": "AWS::EC2::Image::Id",
      "Description": "Verified official Ubuntu 24.04 amd64 AMI in the deployment region"
    },
    "HostedZoneId": {
      "Type": "AWS::Route53::HostedZone::Id",
      "Description": "Existing public zone; creates only the unused Hostname record"
    },
    "Hostname": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9][a-z0-9.-]+",
      "Description": "Unused trial FQDN owned by the operator; never an existing site name"
    }
  },
  "Resources": {
    "Network": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.77.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {"Key": "Name", "Value": {"Fn::Sub": "${AWS::StackName}-vpc"}},
          {"Key": "Project", "Value": "daifuku"},
          {"Key": "Environment", "Value": "trial"}
        ]
      }
    },
    "Gateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {"Key": "Name", "Value": {"Fn::Sub": "${AWS::StackName}-igw"}},
          {"Key": "Project", "Value": "daifuku"},
          {"Key": "Environment", "Value": "trial"}
        ]
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {"VpcId": {"Ref": "Network"}, "InternetGatewayId": {"Ref": "Gateway"}}
    },
    "Subnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {"Ref": "Network"},
        "CidrBlock": "10.77.1.0/24",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {"Key": "Name", "Value": {"Fn::Sub": "${AWS::StackName}-subnet"}},
          {"Key": "Project", "Value": "daifuku"},
          {"Key": "Environment", "Value": "trial"}
        ]
      }
    },
    "RouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {"Ref": "Network"},
        "Tags": [
          {"Key": "Name", "Value": {"Fn::Sub": "${AWS::StackName}-routes"}},
          {"Key": "Project", "Value": "daifuku"},
          {"Key": "Environment", "Value": "trial"}
        ]
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {"Ref": "RouteTable"},
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {"Ref": "Gateway"}
      },
      "DependsOn": "GatewayAttachment"
    },
    "SubnetRoute": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {"SubnetId": {"Ref": "Subnet"}, "RouteTableId": {"Ref": "RouteTable"}}
    },
    "WebSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Daifuku trial HTTPS and ACME only; no SSH or database ingress",
        "VpcId": {"Ref": "Network"},
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0",
            "Description": "ACME and HTTPS redirect"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0",
            "Description": "HTTPS"
          }
        ],
        "SecurityGroupEgress": [{"IpProtocol": "-1", "CidrIp": "0.0.0.0/0"}],
        "Tags": [
          {"Key": "Name", "Value": {"Fn::Sub": "${AWS::StackName}-web"}},
          {"Key": "Project", "Value": "daifuku"},
          {"Key": "Environment", "Value": "trial"}
        ]
      }
    },
    "Artifacts": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {"Rules": [{"ObjectOwnership": "BucketOwnerEnforced"}]},
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [{"ServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}]
        },
        "VersioningConfiguration": {"Status": "Enabled"},
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "backup-retention",
              "Status": "Enabled",
              "Prefix": "backups/",
              "ExpirationInDays": 14,
              "NoncurrentVersionExpiration": {"NoncurrentDays": 14},
              "AbortIncompleteMultipartUpload": {"DaysAfterInitiation": 1}
            }
          ]
        },
        "Tags": [
          {"Key": "Name", "Value": {"Fn::Sub": "${AWS::StackName}-artifacts"}},
          {"Key": "Project", "Value": "daifuku"},
          {"Key": "Environment", "Value": "trial"}
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ArtifactsPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {"Ref": "Artifacts"},
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [{"Fn::GetAtt": ["Artifacts", "Arn"]}, {"Fn::Sub": "${Artifacts.Arn}/*"}],
              "Condition": {"Bool": {"aws:SecureTransport": "false"}}
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "InstanceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{"Effect": "Allow", "Principal": {"Service": "ec2.amazonaws.com"}, "Action": "sts:AssumeRole"}]
        },
        "ManagedPolicyArns": [{"Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"}],
        "Policies": [
          {
            "PolicyName": "OnlyTrialArtifacts",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": ["s3:GetObject"],
                  "Resource": {"Fn::Sub": "${Artifacts.Arn}/releases/*"}
                },
                {
                  "Effect": "Allow",
                  "Action": ["s3:PutObject", "s3:AbortMultipartUpload"],
                  "Resource": {"Fn::Sub": "${Artifacts.Arn}/backups/*"}
                }
              ]
            }
          },
          {
            "PolicyName": "DenyParameterStoreReads",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Deny",
                  "Action": [
                    "ssm:GetParameter",
                    "ssm:GetParameters",
                    "ssm:GetParametersByPath",
                    "ssm:GetParameterHistory"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ],
        "Tags": [
          {"Key": "Name", "Value": {"Fn::Sub": "${AWS::StackName}-role"}},
          {"Key": "Project", "Value": "daifuku"},
          {"Key": "Environment", "Value": "trial"}
        ]
      }
    },
    "InstanceProfile": {"Type": "AWS::IAM::InstanceProfile", "Properties": {"Roles": [{"Ref": "InstanceRole"}]}},
    "Server": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {"Ref": "ImageId"},
        "InstanceType": "t3.small",
        "CreditSpecification": {"CPUCredits": "standard"},
        "IamInstanceProfile": {"Ref": "InstanceProfile"},
        "SubnetId": {"Ref": "Subnet"},
        "SecurityGroupIds": [{"Ref": "WebSecurityGroup"}],
        "MetadataOptions": {"HttpTokens": "required", "HttpPutResponseHopLimit": 1, "InstanceMetadataTags": "disabled"},
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {"VolumeType": "gp3", "VolumeSize": 30, "Encrypted": true, "DeleteOnTermination": true}
          }
        ],
        "DisableApiTermination": true,
        "InstanceInitiatedShutdownBehavior": "stop",
        "Tags": [
          {"Key": "Name", "Value": {"Fn::Sub": "${AWS::StackName}-server"}},
          {"Key": "Project", "Value": "daifuku"},
          {"Key": "Environment", "Value": "trial"}
        ]
      },
      "DependsOn": ["InternetRoute", "SubnetRoute"]
    },
    "Address": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {"Key": "Name", "Value": {"Fn::Sub": "${AWS::StackName}-ip"}},
          {"Key": "Project", "Value": "daifuku"},
          {"Key": "Environment", "Value": "trial"}
        ]
      },
      "DependsOn": "GatewayAttachment"
    },
    "AddressAssociation": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {"InstanceId": {"Ref": "Server"}, "AllocationId": {"Fn::GetAtt": ["Address", "AllocationId"]}}
    },
    "TrialDNS": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {"Ref": "HostedZoneId"},
        "Name": {"Ref": "Hostname"},
        "Type": "A",
        "TTL": "60",
        "ResourceRecords": [{"Ref": "Address"}]
      }
    }
  },
  "Outputs": {
    "InstanceId": {"Value": {"Ref": "Server"}},
    "VpcId": {"Value": {"Ref": "Network"}},
    "PublicIp": {"Value": {"Ref": "Address"}},
    "ArtifactsBucket": {"Value": {"Ref": "Artifacts"}},
    "Url": {"Value": {"Fn::Sub": "https://${Hostname}"}}
  }
}
